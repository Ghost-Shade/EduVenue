# ---------------------------------------------------------------------------
# EduVenue - environment template
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   PowerShell:  Copy-Item .env.example .env
#
# Every value below is a placeholder. None of them are real credentials.
# ---------------------------------------------------------------------------

# Secret used to sign session cookie tokens. Generate your own with:
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# Must be at least 32 characters. Changing it invalidates all active sessions.
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Port the Express server listens on.
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Path to the SQLite database file, relative to the server directory.
# The default below keeps the database out of version control (see .gitignore).
DATABASE_FILE=../data/eduvenue.db

# Path to the separate database used by the automated test suite. The tests
# wipe this file, so it must never point at your development database.
TEST_DATABASE_FILE=../data/eduvenue.test.db

# Set to "true" to enable the demo login shortcuts on the sign-in page.
# Demo accounts use publicly documented passwords and exist ONLY so that judges
# and developers can switch roles quickly. Set to "false" for any real use.
ENABLE_DEMO_LOGINS=true
