# ---------------------------------------------------------------------------
# EduVenue - environment template
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   PowerShell:  Copy-Item .env.example .env
#
# Every value below is a placeholder. None of them are real credentials.
#
# NOTE: there is no SESSION_SECRET and no credential of any kind, because there
# is no authentication. The application opens as a demo identity and every rule
# is still enforced server-side for whichever identity is acting. See
# server/src/services/identityService.ts.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# PostgreSQL. There is no SQLite build: development, the automated test suite
# and the deployed instance all run Postgres, so a query that works locally
# works in production, and the no-overlap guarantee comes from the same
# database constraint everywhere.
#
# Leave these unset to use the local Docker Compose instance, whose password is
# deliberately published in docker-compose.yml:
#   docker compose up -d
#
# In production this is NOT set by hand. The Vercel/Neon integration injects
# DATABASE_URL into the functions, and its absence is a startup error rather
# than a silent fallback to something local.

# Development database. The default is:
#   postgres://eduvenue:eduvenue_local_only@localhost:5433/eduvenue
DATABASE_URL=

# The test suite's OWN database, not a schema inside the development one.
# `npm test` drops and recreates schemas, and a bug in that code must not be
# able to reach development data - so this must never point at DATABASE_URL.
# The default is:
#   postgres://eduvenue:eduvenue_local_only@localhost:5433/eduvenue_test
TEST_DATABASE_URL=

# The schema to pin `search_path` to. Set ONLY by the test harness, which gives
# each test file its own schema so files `node --test` runs in parallel cannot
# see each other's rows. Ignored outside NODE_ENV=test; leave it unset.
# DATABASE_SCHEMA=

# Connection pool ceiling. Kept small deliberately: serverless platforms run
# many instances, and each one opens its own pool. Raise this only if you are
# running a single long-lived server against a database that can take it.
# DATABASE_POOL_MAX=5
