{
  "name": "eduvenue",
  "version": "1.0.0",
  "private": true,
  "description": "EduVenue - Smart Campus Facilities Discovery, Scheduling and Booking Platform",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    

    "setup": "npm install && npm --prefix server install && npm --prefix client install",

    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:reset": "npm --prefix server run db:reset",

    "test": "npm --prefix server run test",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "build": "npm --prefix client run build",

    "start": "npm --prefix server run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
